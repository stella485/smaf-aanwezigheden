rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Alle gegevens staan onder groepen/<leidingscode>/...
    // Alleen wie de code kent, vindt de gegevens. De lijst met codes opvragen kan niemand.
    match /groepen/{code}/{rest=**} {
      allow read, write: if request.auth != null && code.size() >= 8;
    }
  }
}
